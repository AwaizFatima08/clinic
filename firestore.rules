rules_version = '2';

// Clients only read. Every write goes through the Cloud Functions (functions/src),
// except a patient or the admin marking their own notifications as read.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }
    function ownsDoc() {
      return signedIn() && resource.data.patientUid == request.auth.uid;
    }

    // Clinic name, slot length, booking window … shown on the public page.
    match /settings/clinic {
      allow read: if true;
      allow write: if false;
    }
    // settings/weekly, settings/private (admin alert email)
    match /settings/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Public projection of each date: open slots and taken times, no patient data.
    match /days/{date} {
      allow read: if true;
      allow write: if false;
    }
    match /dayOverrides/{date} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /appointments/{ref} {
      allow read: if isAdmin() || ownsDoc();
      allow write: if false;
    }

    match /patients/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if false;
    }

    match /notifications/{id} {
      function mine() {
        return (isAdmin() && resource.data.audience == 'admin')
          || (signedIn() && resource.data.audience == 'patient' && resource.data.uid == request.auth.uid);
      }
      allow read: if mine();
      allow update: if mine()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
      allow create, delete: if false;
    }

    // Email outbox, processed by the sendMail function.
    match /mail/{id} {
      allow read, write: if false;
    }

    // Reserved for the payments and prescriptions extensions (functions/src/extensions).
    match /payments/{id} {
      allow read: if isAdmin() || ownsDoc();
      allow write: if false;
    }
    match /prescriptions/{id} {
      allow read: if isAdmin() || ownsDoc();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
